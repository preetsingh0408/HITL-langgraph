{
    // Format on save for all languages
    "editor.formatOnSave": true,
    // Enforce configured indentation instead of auto-detecting from file content
    "editor.detectIndentation": false,

    // Default indentation settings
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    // Nice-to-have save hygiene
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    // Ensure formatting runs for TypeScript/JavaScript
    "[javascript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[javascriptreact]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[typescript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[typescriptreact]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },

    // Prefer Prettier if installed
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.tabWidth": 4,
    "prettier.useTabs": false
}
